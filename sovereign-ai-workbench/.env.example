# ==============================================================================
# Sovereign AI Workbench - Environment Configuration Template
# NOTE: Never commit real production secrets to version control.
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security (Replace with a strong random 256-bit key in production)
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sovereign_workbench
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local LLM Inference Engine (Ollama / Local Server)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3:8b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Storage & File Directories
UPLOAD_DIRECTORY=./uploads
WORKSPACE_DIRECTORY=./workspace
MAX_UPLOAD_SIZE_MB=50

# Sandbox Configuration (For Phase 6)
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m

# Frontend Settings
VITE_API_BASE_URL=http://localhost:8000
